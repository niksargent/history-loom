{
  "name": "history-loom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "generate:insights": "node ./scripts/generate-derived-insights.mjs",
    "scaffold:dataset": "node ./scripts/scaffold-dataset.mjs",
    "validate:data": "node ./scripts/validate-datasets.mjs",
    "audit:public-copy": "node ./scripts/audit-public-copy-usage.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:atlas": "vite --host 127.0.0.1",
    "test:atlas": "node tests/atlas/engine.test.mjs",
    "validate:atlas": "node scripts/validate-atlas.mjs",
    "refresh:atlas": "node scripts/import-atlas-data.mjs",
    "add:atlas": "node scripts/add-atlas-moment.mjs",
    "audit:atlas-sources": "node scripts/audit-atlas-sources.mjs",
    "format:atlas": "prettier --write --single-quote --no-semi src/atlas scripts/*atlas*.mjs tests/atlas data/atlas/extensions.json atlas.html"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.0.0",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "postcss": "^8.5.8",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.0"
  }
}
